// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PRODUCTION_OPERATOR
  HEAD_OF_PRODUCTION
  QUALITY_UNIT
  MANAGEMENT_COMPLIANCE
  SYSTEM_ADMINISTRATOR
}

enum BatchStatus {
  DRAFT
  IN_PROGRESS
  PENDING_HOP_REVIEW
  PENDING_QC_REVIEW
  RELEASED
  REJECTED
  QUARANTINED
  ON_HOLD
}

enum SectionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  APPROVED
}

enum ProductType {
  BAR_SOAP
  LIQUID_HAND_SOAP
  OTHER
}

enum AuditActionType {
  CREATE
  EDIT
  CORRECT
  APPROVE
  SIGN
  VIEW
  EXPORT
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
}

enum ReleaseOutcome {
  RELEASED
  REJECTED
  QUARANTINED
}

// Matches the 11 items on the paper form's Section 3 (Pre-Production Checklist)
enum ChecklistItemKey {
  FORMULA_BATCH_SHEET_CURRENT
  RAW_MATERIALS_DISPENSED_VERIFIED
  STOREKEEPER_COSIGNATURE_OBTAINED
  EQUIPMENT_CLEANED_WORKING
  NO_OUT_OF_SERVICE_OR_CALIBRATION_DUE_TAGS
  SCALES_CALIBRATION_CURRENT
  THERMOMETERS_CALIBRATION_CURRENT
  CROSS_CONTAMINATION_PREVENTION_IN_PLACE
  PRODUCTION_AREA_CLEARED_PREPARED
  PERSONAL_HYGIENE_REQUIREMENTS_MET
  PEST_CONTROL_STATUS_CONFIRMED
}

// Free-text supplier name/lot per raw material entry (no Supplier table, per
// user direction), but qualification is still one of these three fixed
// choices because it drives a real save-time gate (see recordRawMaterialEntry).
enum SupplierQualStatus {
  APPROVED
  CONDITIONAL
  BLOCKED
}

// Section 6.2 — 5 fixed checks printed on the paper form.
enum HomogeneityCheckItem {
  HOMOGENEITY
  ABSENCE_OF_FOREIGN_MATTER
  FRAGRANCE_INCORPORATION
  COLORANT_INCORPORATION
  NO_SEPARATION_OR_RICING
}

enum PassFail {
  PASS
  FAIL
}

enum CurePhase {
  PRE_CUT
  POST_CUT
}

enum DispositionType {
  TESTED_RELEASED
  RETAINED
  DISCARDED
}

// Section 11.1 — 6 fixed items printed on the paper form.
enum PrePackagingChecklistItemKey {
  AREA_CLEARED
  EQUIPMENT_CLEANED_HOP_VERIFIED
  COMPONENTS_FIFO_STORE_LOG
  COA_INSPECTION_REVIEWED
  LABEL_VERSION_CONFIRMED
  WIP_MARKED_PRODUCT_BATCH
}

// Section 13 — 8 fixed equipment rows printed on the paper form (not a
// maintained equipment list; these are the row labels themselves).
enum EquipmentRowKey {
  MIXING_VESSEL_POT
  STICK_BLENDER
  SCALES
  INFRARED_THERMOMETER
  MOLDS
  CUTTING_MACHINES
  PACKAGING_EQUIPMENT
  OTHER
}

enum DeviationType {
  INCIDENT
  DEVIATION
  CRITICAL_DEVIATION
}

enum DeviationStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum YesNoNA {
  YES
  NO
  NA
}

// Section 16 — 21 fixed items printed on the paper form.
enum CompletenessReviewItemKey {
  FORMULA_VERSION_DOCUMENTED
  RAW_MATERIALS_RECORDED_WITH_COA_AND_QUALIFICATION
  PRODUCTION_STEPS_COMPLETED_INITIALED
  TEMPERATURES_RECORDED
  SAMPLING_LOG_COMPLETE_WITH_DISPOSITION
  PH_AND_FREE_CAUSTIC_RECORDED
  YIELD_RECONCILIATION_COMPLETED
  CURE_HOLD_RECORD_COMPLETED
  CUTTING_OBSERVATIONS_RECORDED
  COMPLAINT_RECALL_AE_FIELDS_COMPLETED_OR_NA
  DEVIATION_SECTION_COMPLETED
  RETAINED_SAMPLES_DOCUMENTED
  EQUIPMENT_CLEANING_VERIFICATION_COMPLETE
  PACKAGING_OPERATIONS_COMPLETE
  SUBCONTRACTING_FIELD_COMPLETED_OR_NA
  POST_PRODUCTION_CLOSEOUT_ENTRIES_MADE
  RETENTION_DEADLINE_ENTERED
  NO_BLANK_FIELDS
  CORRECTIONS_PROPERLY_MADE
  FINISHED_PRODUCT_SPEC_REFERENCED
  BATCH_STATUS_DECISION_COMPLETED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  fullName     String
  username     String    @unique
  email        String    @unique
  passwordHash String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?

  sessions              Session[]
  auditTrailEntries     AuditTrailEntry[]
  createdBatches        BatchRecord[]                @relation("BatchCreatedBy")
  noDeviationsConfirmed BatchRecord[]                @relation("NoDeviationsConfirmedBy")
  checklistOperatorFor  PreProductionChecklistItem[] @relation("ChecklistOperator")
  checklistHopSignoffs  PreProductionChecklistItem[] @relation("ChecklistHopSignoff")
  releaseDecisions      ReleaseDecision[]
  signOffs              FinalSignOff[]

  rawMaterialStorekeeperVerifications RawMaterialEntry[]          @relation("RawMaterialStorekeeperVerifiedBy")
  rawMaterialHopVerifications         RawMaterialEntry[]          @relation("RawMaterialHopVerifiedBy")
  temperatureEntries                  TemperatureEntry[]
  processingSteps                     ProcessingStep[]
  stampingSetups                      StampingSetup[]
  pressRuns                           PressRun[]
  samplingEntries                     SamplingEntry[]
  prePackagingChecklistItems          PrePackagingChecklistItem[]
  packagingReturns                    PackagingReturn[]
  retainedSampleCollections           RetainedSampleRecord[]      @relation("RetainedSampleCollectedBy")
  retainedSampleDestructions          RetainedSampleRecord[]      @relation("RetainedSampleDestructionAuthorizedBy")
  equipmentVerifications              EquipmentVerification[]
  deviationsReported                  DeviationEntry[]            @relation("DeviationReportedTo")
  deviationsResolved                  DeviationEntry[]            @relation("DeviationResolvedBy")
  postProductionCloseouts             PostProductionCloseout[]
  completenessInitials                CompletenessReviewItem[]    @relation("CompletenessInitials")
  completenessSignatures              CompletenessReviewItem[]    @relation("CompletenessSignature")
  batchNotes                          BatchNote[]
  approvedSections                    SectionCompletionStatus[]

  @@map("users")
}

// DB-backed session (not JWT) so deactivating a user invalidates access immediately.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model BatchRecord {
  id          String @id @default(uuid()) @db.Uuid
  batchNumber String @unique

  // Free text, per user direction — no Product/Formula reference tables.
  productName            String
  productCodeSku         String?
  productType            ProductType
  finishedProductSpecRef String?
  formulaNumber          String
  formulaVersion         String

  batchSizeTarget       Decimal     @db.Decimal(12, 3)
  batchSizeUnit         String
  productionDate        DateTime
  plannedCompletionDate DateTime?
  manufacturingSiteRoom String?
  complaintRecallRef    String?
  adverseEventRef       String?
  retentionDeadline     DateTime
  status                BatchStatus @default(DRAFT)

  // Section 7 batch-level summary and Section 14's "no deviations" alternative
  // to logging entries — pragmatic one-off fields rather than a table for a
  // single column each.
  cuttingOverallComments        String?
  noDeviationsConfirmedByUserId String?   @db.Uuid
  noDeviationsConfirmedByUser   User?     @relation("NoDeviationsConfirmedBy", fields: [noDeviationsConfirmedByUserId], references: [id])
  noDeviationsConfirmedDate     DateTime?

  // Section 2 — free text per user direction (2026-08-07 UI/UX pass), same
  // rationale as the Section 1 fields above: no maintained personnel table,
  // just what's written on the form. Operator is multi-valued (paper form
  // allows more than one); HoP and QC Reviewer are each a single name.
  productionOperatorNames String[]
  headOfProductionName    String?
  qcReviewerName          String?

  createdById String   @db.Uuid
  createdBy   User     @relation("BatchCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sectionStatuses   SectionCompletionStatus[]
  checklistItems    PreProductionChecklistItem[]
  releaseDecision   ReleaseDecision?
  signOffs          FinalSignOff[]
  auditTrailEntries AuditTrailEntry[]

  rawMaterialEntries         RawMaterialEntry[]
  temperatureEntries         TemperatureEntry[]
  processingSteps            ProcessingStep[]
  homogeneityChecks          HomogeneityCheck[]
  cureRecords                CureRecord[]
  cuttingObservations        CuttingObservation[]
  stampingSetup              StampingSetup?
  pressRuns                  PressRun[]
  samplingEntries            SamplingEntry[]
  yieldReconciliation        YieldReconciliation?
  prePackagingChecklistItems PrePackagingChecklistItem[]
  packagingChecks            PackagingCheck[]
  packagingReturn            PackagingReturn?
  retainedSampleRecord       RetainedSampleRecord?
  equipmentVerifications     EquipmentVerification[]
  deviations                 DeviationEntry[]
  postProductionCloseout     PostProductionCloseout?
  completenessReviewItems    CompletenessReviewItem[]
  notes                      BatchNote[]

  @@index([status, productionDate])
  @@map("batch_records")
}

// One row per (batch, section) so the workflow engine can query lock/unlock
// state generically instead of a bespoke status column per section table.
model SectionCompletionStatus {
  id               String        @id @default(uuid()) @db.Uuid
  batchRecordId    String        @db.Uuid
  batchRecord      BatchRecord   @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  sectionNumber    Int
  status           SectionStatus @default(NOT_STARTED)
  // Open-ended log sections (4,5,6,7,8,9) have no field-driven "complete"
  // state, so HoP/QC sign off explicitly once the log is accurate (Phase 4
  // approval mechanism). Cleared whenever a new entry or correction lands —
  // see approveOpenEndedSection / the add*Entry actions for those sections.
  approvedByUserId String?       @db.Uuid
  approvedByUser   User?         @relation(fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  updatedAt        DateTime      @updatedAt

  @@unique([batchRecordId, sectionNumber])
  @@map("section_completion_status")
}

model PreProductionChecklistItem {
  id                     String           @id @default(uuid()) @db.Uuid
  batchRecordId          String           @db.Uuid
  batchRecord            BatchRecord      @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  itemKey                ChecklistItemKey
  verified               Boolean          @default(false)
  operatorInitialsUserId String?          @db.Uuid
  operatorInitialsUser   User?            @relation("ChecklistOperator", fields: [operatorInitialsUserId], references: [id])
  verifiedAt             DateTime?
  hopSignoffUserId       String?          @db.Uuid
  hopSignoffUser         User?            @relation("ChecklistHopSignoff", fields: [hopSignoffUserId], references: [id])
  hopSignoffDate         DateTime?

  @@unique([batchRecordId, itemKey])
  @@map("pre_production_checklist_items")
}

model ReleaseDecision {
  id                       String          @id @default(uuid()) @db.Uuid
  batchRecordId            String          @unique @db.Uuid
  batchRecord              BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  finishedProductSpecRef   String?
  inProcessResultsReviewed Boolean?
  oosResultsPending        Boolean         @default(false)
  decision                 ReleaseOutcome?
  decisionBasisRationale   String?
  reviewedById             String?         @db.Uuid
  reviewedBy               User?           @relation(fields: [reviewedById], references: [id])
  reviewDate               DateTime?

  @@map("release_decisions")
}

model FinalSignOff {
  id                      String      @id @default(uuid()) @db.Uuid
  batchRecordId           String      @db.Uuid
  batchRecord             BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  role                    Role
  userId                  String      @db.Uuid
  user                    User        @relation(fields: [userId], references: [id])
  signatureDate           DateTime    @default(now())
  electronicSignatureHash String

  @@unique([batchRecordId, role])
  @@map("final_sign_offs")
}

// Append-only. DB grants (see prisma/migrations) revoke UPDATE/DELETE on this
// table for the app's runtime role so immutability holds even against a bug
// or a compromised admin session, not just by convention in the app code.
model AuditTrailEntry {
  id                String          @id @default(uuid()) @db.Uuid
  batchRecordId     String?         @db.Uuid
  batchRecord       BatchRecord?    @relation(fields: [batchRecordId], references: [id])
  // Nullable: a failed login with an unrecognized username has no User row to
  // reference. attemptedUsername captures identity for that case only.
  userId            String?         @db.Uuid
  user              User?           @relation(fields: [userId], references: [id])
  attemptedUsername String?
  timestamp         DateTime        @default(now())
  actionType        AuditActionType
  entityType        String
  entityId          String
  fieldName         String?
  oldValue          String?
  newValue          String?
  correctionReason  String?
  ipAddress         String?
  sessionId         String?

  @@index([batchRecordId])
  @@index([entityType, entityId])
  @@map("audit_trail_entries")
}

// ===== Section 4 — Raw Material Log =====
model RawMaterialEntry {
  id                      String             @id @default(uuid()) @db.Uuid
  batchRecordId           String             @db.Uuid
  batchRecord             BatchRecord        @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  lineNumber              Int
  tradeNameDescription    String
  internalPartCode        String?
  supplierName            String
  supplierLotBatchNumber  String
  qtyDispensed            Decimal            @db.Decimal(12, 3)
  unit                    String
  coaReceived             Boolean            @default(false)
  supplierQualStatus      SupplierQualStatus
  notes                   String?
  verifiedByStorekeeperId String?            @db.Uuid
  verifiedByStorekeeper   User?              @relation("RawMaterialStorekeeperVerifiedBy", fields: [verifiedByStorekeeperId], references: [id])
  storekeeperInitials     String?
  storekeeperVerifiedDate DateTime?
  verifiedByHopId         String?            @db.Uuid
  verifiedByHop           User?              @relation("RawMaterialHopVerifiedBy", fields: [verifiedByHopId], references: [id])
  hopVerifiedDate         DateTime?
  createdAt               DateTime           @default(now())

  // Corrections are new rows, not edits to history (Phase 4 plan) — a row
  // with correctsEntryId set replaces the row it points at, which then reads
  // as superseded (any row pointing at it) rather than being mutated.
  correctsEntryId    String?            @db.Uuid
  correctsEntry      RawMaterialEntry?  @relation("RawMaterialEntryCorrection", fields: [correctsEntryId], references: [id])
  correctedByEntries RawMaterialEntry[] @relation("RawMaterialEntryCorrection")
  correctionReason   String?

  @@index([supplierLotBatchNumber])
  @@map("raw_material_entries")
}

// ===== Section 5 — Raw Material Temperatures =====
model TemperatureEntry {
  id                 String      @id @default(uuid()) @db.Uuid
  batchRecordId      String      @db.Uuid
  batchRecord        BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  lineNumber         Int
  materialIngredient String
  acceptableTempMinF Decimal     @db.Decimal(6, 2)
  acceptableTempMaxF Decimal     @db.Decimal(6, 2)
  actualTempF        Decimal     @db.Decimal(6, 2)
  withinRange        Boolean
  timeOfAddition     DateTime
  operatorUserId     String      @db.Uuid
  operatorUser       User        @relation(fields: [operatorUserId], references: [id])
  createdAt          DateTime    @default(now())

  correctsEntryId    String?            @db.Uuid
  correctsEntry      TemperatureEntry?  @relation("TemperatureEntryCorrection", fields: [correctsEntryId], references: [id])
  correctedByEntries TemperatureEntry[] @relation("TemperatureEntryCorrection")
  correctionReason   String?

  @@map("temperature_entries")
}

// ===== Section 6.1 — Processing Steps =====
model ProcessingStep {
  id                String      @id @default(uuid()) @db.Uuid
  batchRecordId     String      @db.Uuid
  batchRecord       BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  stepNumber        Int
  stepDescription   String
  timePerformed     DateTime
  performedByUserId String      @db.Uuid
  performedByUser   User        @relation(fields: [performedByUserId], references: [id])
  observationsNotes String?
  createdAt         DateTime    @default(now())

  correctsEntryId    String?          @db.Uuid
  correctsEntry      ProcessingStep?  @relation("ProcessingStepCorrection", fields: [correctsEntryId], references: [id])
  correctedByEntries ProcessingStep[] @relation("ProcessingStepCorrection")
  correctionReason   String?

  @@map("processing_steps")
}

// ===== Section 6.2 — Visual Homogeneity Checks (5 fixed items) =====
model HomogeneityCheck {
  id            String               @id @default(uuid()) @db.Uuid
  batchRecordId String               @db.Uuid
  batchRecord   BatchRecord          @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  checkItem     HomogeneityCheckItem
  timeObserved  DateTime?
  result        PassFail?
  comments      String?

  @@unique([batchRecordId, checkItem])
  @@map("homogeneity_checks")
}

// ===== Section 6.3 / 6.4 — Cure/Hold Record (one row per phase) =====
model CureRecord {
  id                       String      @id @default(uuid()) @db.Uuid
  batchRecordId            String      @db.Uuid
  batchRecord              BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  phase                    CurePhase
  dateTimeStart            DateTime?
  targetCureDuration       String?
  dateTimeRemoved          DateTime?
  curingLocationConditions String?
  curePeriodAcceptable     Boolean?
  // Section 6.4 (POST_CUT) only:
  phMeasurementDateTime    DateTime?
  phResult                 Decimal?    @db.Decimal(5, 2)
  freeCausticCheckMethod   String?
  freeCausticCheckResult   String?

  @@unique([batchRecordId, phase])
  @@map("cure_records")
}

// ===== Section 7 — Soap Block Cutting Observations =====
model CuttingObservation {
  id                          String      @id @default(uuid()) @db.Uuid
  batchRecordId               String      @db.Uuid
  batchRecord                 BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  pourNumber                  Int
  tempTopF                    Decimal?    @db.Decimal(6, 2)
  tempSideF                   Decimal?    @db.Decimal(6, 2)
  tempMiddleF                 Decimal?    @db.Decimal(6, 2)
  colorUniformity             String?
  visibleSeparation           Boolean     @default(false)
  foreignMatter               Boolean     @default(false)
  fragranceAdditionalComments String?
  createdAt                   DateTime    @default(now())

  correctsEntryId    String?              @db.Uuid
  correctsEntry      CuttingObservation?  @relation("CuttingObservationCorrection", fields: [correctsEntryId], references: [id])
  correctedByEntries CuttingObservation[] @relation("CuttingObservationCorrection")
  correctionReason   String?

  @@map("cutting_observations")
}

// ===== Section 8.1 — Stamping Setup (one row per batch) =====
model StampingSetup {
  id                    String      @id @default(uuid()) @db.Uuid
  batchRecordId         String      @unique @db.Uuid
  batchRecord           BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  dieStampId            String
  dieConditionInspected Boolean     @default(false)
  setupVerifiedByUserId String?     @db.Uuid
  setupVerifiedByUser   User?       @relation(fields: [setupVerifiedByUserId], references: [id])
  setupDate             DateTime?
  totalBarsStamped      Int?
  totalBarsRejected     Int?

  @@map("stamping_setups")
}

// ===== Section 8.2 — Press Log =====
model PressRun {
  id                  String      @id @default(uuid()) @db.Uuid
  batchRecordId       String      @db.Uuid
  batchRecord         BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  dateTime            DateTime
  dieStampId          String
  impressionQuality   String?
  barSurfaceCondition String?
  appearanceOk        Boolean     @default(true)
  operatorUserId      String      @db.Uuid
  operatorUser        User        @relation(fields: [operatorUserId], references: [id])
  createdAt           DateTime    @default(now())

  correctsEntryId    String?    @db.Uuid
  correctsEntry      PressRun?  @relation("PressRunCorrection", fields: [correctsEntryId], references: [id])
  correctedByEntries PressRun[] @relation("PressRunCorrection")
  correctionReason   String?

  @@map("press_runs")
}

// ===== Section 9 — In-Process Sampling Log =====
model SamplingEntry {
  id                String          @id @default(uuid()) @db.Uuid
  batchRecordId     String          @db.Uuid
  batchRecord       BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  dateTime          DateTime
  samplingStage     String
  testType          String
  resultObservation String?
  actionTaken       String?
  disposition       DispositionType
  dispositionReason String?
  samplerUserId     String          @db.Uuid
  samplerUser       User            @relation(fields: [samplerUserId], references: [id])
  createdAt         DateTime        @default(now())

  correctsEntryId    String?         @db.Uuid
  correctsEntry      SamplingEntry?  @relation("SamplingEntryCorrection", fields: [correctsEntryId], references: [id])
  correctedByEntries SamplingEntry[] @relation("SamplingEntryCorrection")
  correctionReason   String?

  @@map("sampling_entries")
}

// ===== Section 10 — Yield Reconciliation (one row per batch) =====
model YieldReconciliation {
  id                     String      @id @default(uuid()) @db.Uuid
  batchRecordId          String      @unique @db.Uuid
  batchRecord            BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  expectedYield          Decimal     @db.Decimal(12, 3)
  expectedYieldUnit      String
  actualYield            Decimal     @db.Decimal(12, 3)
  actualYieldUnit        String
  varianceAcceptable     Boolean
  investigationInitiated Boolean?
  notesDisposition       String?

  @@map("yield_reconciliations")
}

// ===== Section 11.1 — Pre-Packaging Checklist (6 fixed items) =====
model PrePackagingChecklistItem {
  id             String                       @id @default(uuid()) @db.Uuid
  batchRecordId  String                       @db.Uuid
  batchRecord    BatchRecord                  @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  itemKey        PrePackagingChecklistItemKey
  verified       Boolean                      @default(false)
  verifiedById   String?                      @db.Uuid
  verifiedByUser User?                        @relation(fields: [verifiedById], references: [id])
  verifiedAt     DateTime?

  @@unique([batchRecordId, itemKey])
  @@map("pre_packaging_checklist_items")
}

// ===== Section 11.2 — In-Process Packaging Checks =====
model PackagingCheck {
  id               String      @id @default(uuid()) @db.Uuid
  batchRecordId    String      @db.Uuid
  batchRecord      BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  checkNumber      Int
  time             DateTime
  componentCorrect Boolean     @default(true)
  labelCorrect     Boolean     @default(true)
  appearanceOk     Boolean     @default(true)
  fillWeightOk     Boolean     @default(true)
  notes            String?

  @@map("packaging_checks")
}

// ===== Section 11.3 — Unused Packaging Return (one row per batch) =====
model PackagingReturn {
  id                 String      @id @default(uuid()) @db.Uuid
  batchRecordId      String      @unique @db.Uuid
  batchRecord        BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  returned           YesNoNA
  quantitiesReturned String?
  returnedByUserId   String?     @db.Uuid
  returnedByUser     User?       @relation(fields: [returnedByUserId], references: [id])
  returnedDate       DateTime?

  @@map("packaging_returns")
}

// ===== Section 12 — Retained Sample Record (one row per batch) =====
model RetainedSampleRecord {
  id                             String      @id @default(uuid()) @db.Uuid
  batchRecordId                  String      @unique @db.Uuid
  batchRecord                    BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  unitsCollected                 Int
  sampleLabelApplied             Boolean     @default(false)
  storageLocation                String
  dateCollected                  DateTime
  collectedByUserId              String      @db.Uuid
  collectedByUser                User        @relation("RetainedSampleCollectedBy", fields: [collectedByUserId], references: [id])
  notes                          String?
  minimumRetentionPeriod         String?
  scheduledDestructionReviewDate DateTime
  destructionAuthorizedByUserId  String?     @db.Uuid
  destructionAuthorizedByUser    User?       @relation("RetainedSampleDestructionAuthorizedBy", fields: [destructionAuthorizedByUserId], references: [id])
  destructionDate                DateTime?

  @@map("retained_sample_records")
}

// ===== Section 13 — Equipment & Cleaning Verification (8 fixed rows) =====
model EquipmentVerification {
  id                 String          @id @default(uuid()) @db.Uuid
  batchRecordId      String          @db.Uuid
  batchRecord        BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  rowKey             EquipmentRowKey
  equipmentId        String?
  cleanedAndVerified Boolean         @default(false)
  calibrationCurrent Boolean         @default(false)
  verifiedByUserId   String?         @db.Uuid
  verifiedByUser     User?           @relation(fields: [verifiedByUserId], references: [id])
  verifiedDate       DateTime?

  @@unique([batchRecordId, rowKey])
  @@map("equipment_verifications")
}

// ===== Section 14 — Deviations & Incidents =====
model DeviationEntry {
  id                    String          @id @default(uuid()) @db.Uuid
  batchRecordId         String          @db.Uuid
  batchRecord           BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  sequenceNumber        Int
  dateTime              DateTime
  type                  DeviationType
  description           String
  correctiveActionTaken String?
  reportedToUserId      String?         @db.Uuid
  reportedToUser        User?           @relation("DeviationReportedTo", fields: [reportedToUserId], references: [id])
  status                DeviationStatus @default(OPEN)
  resolvedByUserId      String?         @db.Uuid
  resolvedByUser        User?           @relation("DeviationResolvedBy", fields: [resolvedByUserId], references: [id])
  resolutionRationale   String?
  resolvedDate          DateTime?
  createdAt             DateTime        @default(now())

  @@map("deviation_entries")
}

// ===== Section 15 — Bulk Storage & Post-Production Closeout (one row per batch) =====
model PostProductionCloseout {
  id                          String      @id @default(uuid()) @db.Uuid
  batchRecordId               String      @unique @db.Uuid
  batchRecord                 BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  bulkStorageLocation         String
  enteredInStoreLog           Boolean     @default(false)
  enteredInErp                YesNoNA
  unusedRmReturned            YesNoNA
  quantitiesRmReturned        String?
  stepsSubcontracted          Boolean     @default(false)
  subcontractorNameStep       String?
  subcontractorRecordAttached Boolean?
  batchCloseoutDate           DateTime
  closeoutByUserId            String      @db.Uuid
  closeoutByUser              User        @relation(fields: [closeoutByUserId], references: [id])

  @@map("post_production_closeouts")
}

// ===== Section 16 — Batch Record Completeness Review (21 fixed items) =====
model CompletenessReviewItem {
  id                 String                    @id @default(uuid()) @db.Uuid
  batchRecordId      String                    @db.Uuid
  batchRecord        BatchRecord               @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  itemKey            CompletenessReviewItemKey
  verified           Boolean                   @default(false)
  notApplicable      Boolean                   @default(false)
  hopInitialsUserId  String?                   @db.Uuid
  hopInitialsUser    User?                     @relation("CompletenessInitials", fields: [hopInitialsUserId], references: [id])
  hopSignatureUserId String?                   @db.Uuid
  hopSignatureUser   User?                     @relation("CompletenessSignature", fields: [hopSignatureUserId], references: [id])
  hopSignatureDate   DateTime?

  @@unique([batchRecordId, itemKey])
  @@map("completeness_review_items")
}

// ===== Section 19 — Additional Observations & Notes =====
model BatchNote {
  id            String      @id @default(uuid()) @db.Uuid
  batchRecordId String      @db.Uuid
  batchRecord   BatchRecord @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  authorUserId  String      @db.Uuid
  authorUser    User        @relation(fields: [authorUserId], references: [id])
  note          String
  createdAt     DateTime    @default(now())

  @@map("batch_notes")
}
